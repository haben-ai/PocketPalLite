{
  "extends": "@react-native/typescript-config/tsconfig.json",
  "compilerOptions": {
    // whisper.rn's package.json "exports" map has no root entry, so TS's
    // "bundler" resolution can't find it even though Metro resolves it fine
    // via the "react-native" field -- point TS straight at its shipped types.
    "paths": {
      "whisper.rn": ["./node_modules/whisper.rn/lib/typescript/index.d.ts"]
    }
  }
}
